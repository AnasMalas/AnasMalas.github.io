    const routes = {
      "/bcv2": "/bcv2/",
      "/bcv2/console": "/bcv2/console/",
      "/bc2": "/bcv2/",
      "/bc2/console": "/bcv2/console/",
    };
    const path = location.pathname.toLowerCase().replace(/\/index\.html$/, "").replace(/\/+$/, "");
    const target = routes[path];
    if (target && target !== location.pathname) location.replace(target + location.search + location.hash);
  })();
</script>

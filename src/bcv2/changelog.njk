---
layout: layouts/base.njk
title: Whats new on the BCv2 · Anas Malas
description: Firmware release notes for the BCv2 business card.
permalink: /bcv2/changelog/
---
{# Notes live in _data/bcv2Releases.json, newest first. A release without a
   date is still being worked on: it shows here as Coming, and stays out of
   the feed until it has one. #}
{% set notes = bcv2Releases %}
<article class="note-page bcv2-update bcv2-changelog">
  <header class="note-hero shell reading-width">
    <a class="back-link" href="/bcv2/">← BCv2 guide</a>
    <p class="eyebrow"><span class="status-dot" aria-hidden="true"></span>BCv2</p>
    <h1 class="note-title">Whats new</h1>
    <p class="note-dek">Firmware release notes. <a href="/bcv2/update/">Update your card</a>.</p>
  </header>

  <div class="note-body reading-width">
    <section class="update-card" id="follow">
      <h2>Get notified</h2>
      <p><strong>Email:</strong> watch the <a href="{{ notes.repo }}" rel="noopener">BCv2 releases</a> on GitHub (Watch &gt; Custom &gt; Releases).</p>
      <p><strong>Feed:</strong> <a href="{{ notes.feed }}">anasmalas.com{{ notes.feed }}</a></p>
    </section>

    {% for release in notes.releases %}
    <section class="bcv2-release" id="{{ release.version | replace('.', '-') }}">
      <h2>{{ release.version }}{% if release.date %} <span class="bcv2-release-date">{{ release.date | readableDate }}</span>{% else %} <span class="beta">Coming</span>{% endif %}</h2>
      {% if not release.date %}<p class="update-aside">Not released yet, this list might change.</p>{% endif %}
      <ul>
        {% for change in release.changes %}<li>{{ change }}</li>
        {% endfor %}
      </ul>
      {# Console changes are listed only when they needed new firmware. #}
      {% if release.console %}
      <h3>In the console</h3>
      <ul>
        {% for change in release.console %}<li>{{ change }}</li>
        {% endfor %}
      </ul>
      {% endif %}
      {% if release.build %}<p class="update-aside">Firmware {{ release.build }}</p>{% endif %}
    </section>
    {% endfor %}
  </div>
</article>

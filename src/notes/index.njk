---
layout: layouts/base.njk
title: Articles — Anas Malas
description: Electronics, mechanical design, and experiments by Anas Malas.
permalink: /notes/
---

<section class="archive-header shell">
  <a class="back-link" href="/">← Home</a>
  <p class="section-label">Archive</p>
  <h1>Articles</h1>
  <p>Electronics, mechanical design, and experiments.</p>
</section>

<section class="archive-list shell">
  {% for item in linkedin.articles %}
  {% set media = presentation[item.slug] %}
  {% set post = item | readingPost %}
  <article class="archive-row">
    <div class="archive-meta"><span class="post-kind">Article</span>{% if media.date %}<time datetime="{{ media.date }}">{{ media.date | readableDate }}</time>{% endif %}</div>
    <div>{% if item.title %}<h2><a href="/#{{ item.slug }}">{{ item.title }}</a></h2>{% endif %}<p class="note-excerpt">{{ item.paragraphs[0] }}</p></div>
    <a class="arrow-link" href="/#{{ item.slug }}" aria-label="Read {{ post.lead }}">↗</a>
  </article>
  {% else %}
  <p class="empty-state">No notes published yet.</p>
  {% endfor %}
</section>
